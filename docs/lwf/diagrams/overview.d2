# Lambda Web Functions ベンチの全体構成
# __MONO__ は単色ロゴの色。render.py がライト用 (000000) とダーク用 (ffffff) に置き換えて 2 枚描く
# 生成: python ~/.claude/skills/arch-diagram/versions/v1.1/scripts/render.py docs/now-post/diagrams/overview.d2
direction: right

vars: {
  d2-config: {
    layout-engine: elk
    pad: 40
  }
}

classes: {
  svc: {
    shape: rectangle
    style: {
      border-radius: 12
      font-size: 15
    }
  }
  ext: {
    shape: image
    width: 64
    height: 64
    label.near: outside-bottom-center
  }
  zone: {
    style.border-radius: 16
  }
}

pc: 計測 PC (Windows・自宅回線) {
  class: zone
  icon: https://icons.terrastruct.com/tech%2Flaptop.svg

  bench: "bench-remote.mjs\n逐次計測 + autocannon 50 並列" {
    class: svc
    icon: https://cdn.simpleicons.org/nodedotjs
  }
  cost: "lwf-cost.mjs\nメトリクス × 単価で費用を算出" {
    class: svc
    icon: https://cdn.simpleicons.org/nodedotjs
  }
}

aws: AWS Cloud {
  class: zone
  icon: https://icons.terrastruct.com/aws%2F_Group%20Icons%2FAWS-Cloud_light-bg.svg

  tokyo: ap-northeast-1 (東京) {
    class: zone
    icon: https://icons.terrastruct.com/aws%2F_Group%20Icons%2FRegion_light-bg.svg

    lwf: "Lambda Web Functions (Node.js 24・arm64・2 vCPU / 2 GB / 環境)" {
      class: zone
      icon: https://icons.terrastruct.com/aws%2FCompute%2FAWS-Lambda.svg

      apps: "SSR アプリ 5 種 (同じ EC カタログ画面)" {
        class: zone
        direction: down

        sveltekit: "sveltekit\nSvelteKit 3 + adapter-node" {
          class: svc
          icon: https://cdn.simpleicons.org/svelte
        }
        tanstack: "tanstack\nTanStack Start (Nitro)" {
          class: svc
          icon: https://cdn.simpleicons.org/tanstack/__MONO__
        }
        next: "next\nNext.js 16.4 standalone" {
          class: svc
          icon: https://cdn.simpleicons.org/nextdotjs/__MONO__
        }
        nextcc: "next-cc\n+ cacheComponents" {
          class: svc
          icon: https://cdn.simpleicons.org/nextdotjs/__MONO__
        }
        nextcached: "next-cached\n+ cacheComponents + キャッシュ" {
          class: svc
          icon: https://cdn.simpleicons.org/nextdotjs/__MONO__
        }
      }

      api: "data-api\n疑似 API (商品 50ms・在庫 30ms・おすすめ 300ms)" {
        class: svc
        icon: https://cdn.simpleicons.org/nodedotjs
      }
    }

    cw: "CloudWatch\nAWS/Lambda/Web メトリクス・Logs" {
      class: svc
      icon: https://icons.terrastruct.com/aws%2FManagement%20&%20Governance%2FAmazon-CloudWatch.svg
    }
  }

  pricing: "Pricing API\nTokyo の Arm 単価" {
    class: svc
    icon: https://icons.terrastruct.com/aws%2FAWS%20Cost%20Management%2FAWS-Cost-Explorer.svg
  }
}

pc.bench -> aws.tokyo.lwf.apps: "HTTPS (各アプリの既定エンドポイント)"
aws.tokyo.lwf.apps -> aws.tokyo.lwf.api: "HTTPS (DATA_API_URL)"
aws.tokyo.lwf -> aws.tokyo.cw: リクエスト数・CPU 時間・環境の生存時間 {style.stroke-dash: 4}
pc.cost -> aws.tokyo.cw: メトリクスを取得 (get-metric-statistics) {style.stroke-dash: 4}
pc.cost -> aws.pricing: 単価を取得 (get-products) {style.stroke-dash: 4}
