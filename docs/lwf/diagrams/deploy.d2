# cdk-lambda-web (自作 L2) でのデプロイ構成と、初回デプロイで見つかった不具合
# 生成: python ~/.claude/skills/arch-diagram/versions/v1.1/scripts/render.py docs/now-post/diagrams/deploy.d2
direction: down

vars: {
  d2-config: {
    layout-engine: elk
    pad: 40
  }
}

classes: {
  svc: {
    shape: rectangle
    style: {
      border-radius: 12
      font-size: 15
    }
  }
  zone: {
    style.border-radius: 16
  }
  bug: {
    shape: page
    style: {
      stroke: "#d93025"
      font-color: "#d93025"
      stroke-width: 2
      font-size: 14
    }
  }
}

pc: 手元 PC (AWS CLI のプロファイル) {
  class: zone
  icon: https://icons.terrastruct.com/tech%2Flaptop.svg

  cdk: "infra-lwf (CDK app)\nWebFunction × 6" {
    class: svc
    icon: https://icons.terrastruct.com/aws%2FDeveloper%20Tools%2FAWS-Cloud-Development-Kit.svg
  }
  l2: "cdk-lambda-web\n自作 L2 (GitHub から導入)" {
    class: svc
    icon: https://cdn.simpleicons.org/github/__MONO__
  }
}

aws: AWS Cloud / ap-northeast-1 {
  class: zone
  icon: https://icons.terrastruct.com/aws%2F_Group%20Icons%2FAWS-Cloud_light-bg.svg

  cfn: "CloudFormation\nスタック BenchLwf" {
    class: svc
    icon: https://icons.terrastruct.com/aws%2FManagement%20&%20Governance%2FAWS-CloudFormation.svg
  }

  s3: "コード用バケット (バージョニング有効)\n<関数名>/<hash>.zip を versionId 指定で読ませる" {
    class: svc
    icon: https://icons.terrastruct.com/aws%2FStorage%2FAmazon-Simple-Storage-Service-S3.svg
  }

  role: "ServiceRole (実行ロール)\nlambda.amazonaws.com が引き受ける" {
    class: svc
    icon: https://icons.terrastruct.com/aws%2FSecurity%2C%20Identity%2C%20&%20Compliance%2FAWS-Identify-and-Access-Management_IAM.svg
  }

  fn: "Web Function (bench-<名前>)" {
    class: zone
    icon: https://icons.terrastruct.com/aws%2FCompute%2FAWS-Lambda.svg
    direction: right

    wf: "WebFunction\n関数の器" {class: svc}
    rev: "WebFunctionRevision\nコード (S3 key + versionId)・環境変数" {class: svc}
    ep: "WebFunctionEndpoint\nhttps://….lambda-web…on.aws" {class: svc}
    wf -> rev -> ep
  }
}

bug: "初回デプロイの失敗点\nBucketDeployment の objectKeys は prefix を含まない\n→ key が <hash>.zip になり S3 object does not exist で失敗\n→ <関数名>/ を付け直して回避" {class: bug}

pc.cdk -> pc.l2: 使う
pc.cdk -> aws.cfn: cdk deploy
pc.cdk -> aws.s3: アセット zip (BucketDeployment)
aws.cfn -> aws.fn: 作成
aws.cfn -> aws.role: 作成
aws.s3 -> aws.fn.rev
aws.role -> aws.fn.rev
bug -> aws.fn.rev {style.stroke: "#d93025"; style.stroke-dash: 4}
